placian": "\\mathbf{\\nabla ^2}",&#10; "\\label": "{}",&#10; "\\negadelta": "\\nabla",&#10; "\\eqref": "\\href{###1}{(\\text{#1})}",&#10; "\\ref": "\\href{###1}{\\text{#1}}",&#10; "\\label": "\\htmlId{#1}{}",&#10; }&#10; });&#10; };&#10;&lt;/script&gt;&lt;span&gt;&#10; \[\]&#10;&lt;/span&gt;&#10;&#10;&lt;h2 id="syllabus"&gt;Syllabus&lt;a class="anchor" href="#syllabus"&gt;#&lt;/a&gt;&lt;/h2&gt;&#10;&lt;p&gt;The goals of this course are:&lt;/p&gt;</description></item><item><title>General Diagnostic Considerations</title><link>https://peppyhare.github.io/r/notes/UWAA560/02-diagnostic-considerations/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://peppyhare.github.io/r/notes/UWAA560/02-diagnostic-considerations/</guid><description>&lt;h1 id="general-diagnostic-considerations"&gt;General Diagnostic Considerations&lt;a class="anchor" href="#general-diagnostic-considerations"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&#10;&lt;link rel="stylesheet" href="https://peppyhare.github.io/r/katex/katex.min.css" /&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/katex.min.js"&gt;&lt;/script&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/auto-render.min.js" onload="loadKatex();"&gt;&lt;/script&gt;&#10;&#10;&lt;script&gt;&#10; function loadKatex() {&#10; renderMathInElement(document.body, {&#10; delimiters: [&#10; { left: "$$", right: "$$", display: true },&#10; { left: "\\[", right: "\\]", display: true },&#10; { left: "$", right: "$", display: false },&#10; { left: "\\(", right: "\\)", display: false }],&#10; throwOnError: false,&#10; trust: (context) =&gt; ['\\htmlId', '\\href'].includes(context.command),&#10; macros: {&#10; "\\lcm": "\\mathop{\\mathrm{lcm}}",&#10; "\\sen": '\\text{sen}\\,',&#10; "\\dd": "\\mathop{\\mathrm{d} #1}",&#10; "\\abs": "\\lvert #1 \\rvert",&#10; "\\dd": "\\text{d}",&#10; "\\cross": "\\times",&#10; "\\pdv": "\\frac{\\partial #1}{\\partial #2}",&#10; "\\curl": "\\nabla \\cross #1",&#10; "\\vu": "\\mathbf{\\hat{#1}}",&#10; "\\vdot": "\\dot",&#10; "\\div": "\\nabla \\cdot #1",&#10; "\\grad": "\\nabla",&#10; "\\dv": "\\frac{d\\,#1}{d\\,#2}",&#10; "\\gr": "\\gamma",&#10; "\\vec": "\\mathbf{#1}",&#10; "\\tagl": "\\tag{#1}",&#10; "\\eqref": "(#1)",&#10; "\\laplacian": "\\mathbf{\\nabla ^2}",&#10; "\\label": "{}",&#10; "\\negadelta": "\\nabla",&#10; "\\eqref": "\\href{###1}{(\\text{#1})}",&#10; "\\ref": "\\href{###1}{\\text{#1}}",&#10; "\\label": "\\htmlId{#1}{}",&#10; }&#10; });&#10; };&#10;&lt;/script&gt;&lt;span&gt;&#10; \[\]&#10;&lt;/span&gt;&#10;&#10;&lt;p&gt;First, let us categorize some broad categories of items to consider when we think about plasma diagnostics by asking a few questions:&lt;/p&gt;</description></item><item><title>Magnetic Field Diagnostics</title><link>https://peppyhare.github.io/r/notes/UWAA560/03-magnetic-field-diagnostics/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://peppyhare.github.io/r/notes/UWAA560/03-magnetic-field-diagnostics/</guid><description>&lt;h1 id="b-dot-probe-diagnostics"&gt;B-dot Probe Diagnostics&lt;a class="anchor" href="#b-dot-probe-diagnostics"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;p&gt;Faraday&amp;rsquo;s law is the basis for magnetic field coils:&lt;/p&gt;&#10;&#10;&lt;link rel="stylesheet" href="https://peppyhare.github.io/r/katex/katex.min.css" /&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/katex.min.js"&gt;&lt;/script&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/auto-render.min.js" onload="loadKatex();"&gt;&lt;/script&gt;&#10;&#10;&lt;script&gt;&#10; function loadKatex() {&#10; renderMathInElement(document.body, {&#10; delimiters: [&#10; { left: "$$", right: "$$", display: true },&#10; { left: "\\[", right: "\\]", display: true },&#10; { left: "$", right: "$", display: false },&#10; { left: "\\(", right: "\\)", display: false }],&#10; throwOnError: false,&#10; trust: (context) =&gt; ['\\htmlId', '\\href'].includes(context.command),&#10; macros: {&#10; "\\lcm": "\\mathop{\\mathrm{lcm}}",&#10; "\\sen": '\\text{sen}\\,',&#10; "\\dd": "\\mathop{\\mathrm{d} #1}",&#10; "\\abs": "\\lvert #1 \\rvert",&#10; "\\dd": "\\text{d}",&#10; "\\cross": "\\times",&#10; "\\pdv": "\\frac{\\partial #1}{\\partial #2}",&#10; "\\curl": "\\nabla \\cross #1",&#10; "\\vu": "\\mathbf{\\hat{#1}}",&#10; "\\vdot": "\\dot",&#10; "\\div": "\\nabla \\cdot #1",&#10; "\\grad": "\\nabla",&#10; "\\dv": "\\frac{d\\,#1}{d\\,#2}",&#10; "\\gr": "\\gamma",&#10; "\\vec": "\\mathbf{#1}",&#10; "\\tagl": "\\tag{#1}",&#10; "\\eqref": "(#1)",&#10; "\\laplacian": "\\mathbf{\\nabla ^2}",&#10; "\\label": "{}",&#10; "\\negadelta": "\\nabla",&#10; "\\eqref": "\\href{###1}{(\\text{#1})}",&#10; "\\ref": "\\href{###1}{\\text{#1}}",&#10; "\\label": "\\htmlId{#1}{}",&#10; }&#10; });&#10; };&#10;&lt;/script&gt;&lt;span&gt;&#10; \[\int \pdv{\vec B}{t} \cdot \dd \vec S = - \oint \vec E \cdot \dd \vec l = - V_{emf}\]&#10;&lt;/span&gt;&#10;&#10;&lt;p&gt;For a rigid, perfectly conducting loop of N turns in the presence of a changing magnetic field,&lt;/p&gt;</description></item><item><title>Electrostatic Diagnostics</title><link>https://peppyhare.github.io/r/notes/UWAA560/04-electrostatic-diagnostics/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://peppyhare.github.io/r/notes/UWAA560/04-electrostatic-diagnostics/</guid><description>&lt;link rel="stylesheet" href="https://peppyhare.github.io/r/katex/katex.min.css" /&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/katex.min.js"&gt;&lt;/script&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/auto-render.min.js" onload="loadKatex();"&gt;&lt;/script&gt;&#10;&#10;&lt;script&gt;&#10; function loadKatex() {&#10; renderMathInElement(document.body, {&#10; delimiters: [&#10; { left: "$$", right: "$$", display: true },&#10; { left: "\\[", right: "\\]", display: true },&#10; { left: "$", right: "$", display: false },&#10; { left: "\\(", right: "\\)", display: false }],&#10; throwOnError: false,&#10; trust: (context) =&gt; ['\\htmlId', '\\href'].includes(context.command),&#10; macros: {&#10; "\\lcm": "\\mathop{\\mathrm{lcm}}",&#10; "\\sen": '\\text{sen}\\,',&#10; "\\dd": "\\mathop{\\mathrm{d} #1}",&#10; "\\abs": "\\lvert #1 \\rvert",&#10; "\\dd": "\\text{d}",&#10; "\\cross": "\\times",&#10; "\\pdv": "\\frac{\\partial #1}{\\partial #2}",&#10; "\\curl": "\\nabla \\cross #1",&#10; "\\vu": "\\mathbf{\\hat{#1}}",&#10; "\\vdot": "\\dot",&#10; "\\div": "\\nabla \\cdot #1",&#10; "\\grad": "\\nabla",&#10; "\\dv": "\\frac{d\\,#1}{d\\,#2}",&#10; "\\gr": "\\gamma",&#10; "\\vec": "\\mathbf{#1}",&#10; "\\tagl": "\\tag{#1}",&#10; "\\eqref": "(#1)",&#10; "\\laplacian": "\\mathbf{\\nabla ^2}",&#10; "\\label": "{}",&#10; "\\negadelta": "\\nabla",&#10; "\\eqref": "\\href{###1}{(\\text{#1})}",&#10; "\\ref": "\\href{###1}{\\text{#1}}",&#10; "\\label": "\\htmlId{#1}{}",&#10; }&#10; });&#10; };&#10;&lt;/script&gt;&lt;span&gt;&#10; \[\]&#10;&lt;/span&gt;&#10;&#10;&lt;h1 id="langmuir-probes"&gt;Langmuir Probes&lt;a class="anchor" href="#langmuir-probes"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;p&gt;Langmuir probes are the oldest and simplest plasma diagnostic: You simply insert an electrode into the plasma and measure the \( I \)-\( V \) curve. Doing so is fairly simple, but the probe measurements are often difficult to interpret, since extracting accurate plasma properties from measurements can be challenging.&lt;/p&gt;</description></item><item><title>Index of Refraction Measurements</title><link>https://peppyhare.github.io/r/notes/UWAA560/05-index-of-refraction-measurements/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://peppyhare.github.io/r/notes/UWAA560/05-index-of-refraction-measurements/</guid><description>&lt;link rel="stylesheet" href="https://peppyhare.github.io/r/katex/katex.min.css" /&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/katex.min.js"&gt;&lt;/script&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/auto-render.min.js" onload="loadKatex();"&gt;&lt;/script&gt;&#10;&#10;&lt;script&gt;&#10; function loadKatex() {&#10; renderMathInElement(document.body, {&#10; delimiters: [&#10; { left: "$$", right: "$$", display: true },&#10; { left: "\\[", right: "\\]", display: true },&#10; { left: "$", right: "$", display: false },&#10; { left: "\\(", right: "\\)", display: false }],&#10; throwOnError: false,&#10; trust: (context) =&gt; ['\\htmlId', '\\href'].includes(context.command),&#10; macros: {&#10; "\\lcm": "\\mathop{\\mathrm{lcm}}",&#10; "\\sen": '\\text{sen}\\,',&#10; "\\dd": "\\mathop{\\mathrm{d} #1}",&#10; "\\abs": "\\lvert #1 \\rvert",&#10; "\\dd": "\\text{d}",&#10; "\\cross": "\\times",&#10; "\\pdv": "\\frac{\\partial #1}{\\partial #2}",&#10; "\\curl": "\\nabla \\cross #1",&#10; "\\vu": "\\mathbf{\\hat{#1}}",&#10; "\\vdot": "\\dot",&#10; "\\div": "\\nabla \\cdot #1",&#10; "\\grad": "\\nabla",&#10; "\\dv": "\\frac{d\\,#1}{d\\,#2}",&#10; "\\gr": "\\gamma",&#10; "\\vec": "\\mathbf{#1}",&#10; "\\tagl": "\\tag{#1}",&#10; "\\eqref": "(#1)",&#10; "\\laplacian": "\\mathbf{\\nabla ^2}",&#10; "\\label": "{}",&#10; "\\negadelta": "\\nabla",&#10; "\\eqref": "\\href{###1}{(\\text{#1})}",&#10; "\\ref": "\\href{###1}{\\text{#1}}",&#10; "\\label": "\\htmlId{#1}{}",&#10; }&#10; });&#10; };&#10;&lt;/script&gt;&lt;span&gt;&#10; \[\]&#10;&lt;/span&gt;&#10;&#10;&lt;h1 id="index-of-refraction-measurements"&gt;Index of Refraction Measurements&lt;a class="anchor" href="#index-of-refraction-measurements"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;p&gt;The refractive index is defined as the speed of light (in vacuum) over the phase velocity \( n = \frac{c}{v_{\phi}} \), \( v_\phi = \omega / k \). Recall that in vacuum the phase velocity is just the speed of light (\( n = 1 \) in vacuum). In a plasma, we know that the dispersion relation will be substantially different.&lt;/p&gt;</description></item><item><title>Spectroscopic Measurements</title><link>https://peppyhare.github.io/r/notes/UWAA560/06-spectroscopic-measurements/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://peppyhare.github.io/r/notes/UWAA560/06-spectroscopic-measurements/</guid><description>&lt;link rel="stylesheet" href="https://peppyhare.github.io/r/katex/katex.min.css" /&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/katex.min.js"&gt;&lt;/script&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/auto-render.min.js" onload="loadKatex();"&gt;&lt;/script&gt;&#10;&#10;&lt;script&gt;&#10; function loadKatex() {&#10; renderMathInElement(document.body, {&#10; delimiters: [&#10; { left: "$$", right: "$$", display: true },&#10; { left: "\\[", right: "\\]", display: true },&#10; { left: "$", right: "$", display: false },&#10; { left: "\\(", right: "\\)", display: false }],&#10; throwOnError: false,&#10; trust: (context) =&gt; ['\\htmlId', '\\href'].includes(context.command),&#10; macros: {&#10; "\\lcm": "\\mathop{\\mathrm{lcm}}",&#10; "\\sen": '\\text{sen}\\,',&#10; "\\dd": "\\mathop{\\mathrm{d} #1}",&#10; "\\abs": "\\lvert #1 \\rvert",&#10; "\\dd": "\\text{d}",&#10; "\\cross": "\\times",&#10; "\\pdv": "\\frac{\\partial #1}{\\partial #2}",&#10; "\\curl": "\\nabla \\cross #1",&#10; "\\vu": "\\mathbf{\\hat{#1}}",&#10; "\\vdot": "\\dot",&#10; "\\div": "\\nabla \\cdot #1",&#10; "\\grad": "\\nabla",&#10; "\\dv": "\\frac{d\\,#1}{d\\,#2}",&#10; "\\gr": "\\gamma",&#10; "\\vec": "\\mathbf{#1}",&#10; "\\tagl": "\\tag{#1}",&#10; "\\eqref": "(#1)",&#10; "\\laplacian": "\\mathbf{\\nabla ^2}",&#10; "\\label": "{}",&#10; "\\negadelta": "\\nabla",&#10; "\\eqref": "\\href{###1}{(\\text{#1})}",&#10; "\\ref": "\\href{###1}{\\text{#1}}",&#10; "\\label": "\\htmlId{#1}{}",&#10; }&#10; });&#10; };&#10;&lt;/script&gt;&lt;span&gt;&#10; \[\]&#10;&lt;/span&gt;&#10;&#10;&lt;h1 id="spectroscopic-measurements"&gt;Spectroscopic Measurements&lt;a class="anchor" href="#spectroscopic-measurements"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;h2 id="plasma-self-emission"&gt;Plasma Self-Emission&lt;a class="anchor" href="#plasma-self-emission"&gt;#&lt;/a&gt;&lt;/h2&gt;&#10;&lt;p&gt;Plasmas emit light (electromagnetic radiation) over a broad range of wavelengths. This can be from the X-ray to UV to visible to IR. The emission depends on the plasma constituents, magnetic field, and plasma properties \( n_e, T_e, T_i, \vec v_i \). We should be able to analyze the self-emission to provide a measurements of these properties. These measurements are both rich in information, and completely non-perturbing. Unfortunately, extracting plasma properties from measurements can be extremely complicated, since the emission is influenced by all of these effects together.&lt;/p&gt;</description></item><item><title>Student Lectures</title><link>https://peppyhare.github.io/r/notes/UWAA560/90-student-lectures/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://peppyhare.github.io/r/notes/UWAA560/90-student-lectures/</guid><description>&lt;link rel="stylesheet" href="https://peppyhare.github.io/r/katex/katex.min.css" /&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/katex.min.js"&gt;&lt;/script&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/auto-render.min.js" onload="loadKatex();"&gt;&lt;/script&gt;&#10;&#10;&lt;script&gt;&#10; function loadKatex() {&#10; renderMathInElement(document.body, {&#10; delimiters: [&#10; { left: "$$", right: "$$", display: true },&#10; { left: "\\[", right: "\\]", display: true },&#10; { left: "$", right: "$", display: false },&#10; { left: "\\(", right: "\\)", display: false }],&#10; throwOnError: false,&#10; trust: (context) =&gt; ['\\htmlId', '\\href'].includes(context.command),&#10; macros: {&#10; "\\lcm": "\\mathop{\\mathrm{lcm}}",&#10; "\\sen": '\\text{sen}\\,',&#10; "\\dd": "\\mathop{\\mathrm{d} #1}",&#10; "\\abs": "\\lvert #1 \\rvert",&#10; "\\dd": "\\text{d}",&#10; "\\cross": "\\times",&#10; "\\pdv": "\\frac{\\partial #1}{\\partial #2}",&#10; "\\curl": "\\nabla \\cross #1",&#10; "\\vu": "\\mathbf{\\hat{#1}}",&#10; "\\vdot": "\\dot",&#10; "\\div": "\\nabla \\cdot #1",&#10; "\\grad": "\\nabla",&#10; "\\dv": "\\frac{d\\,#1}{d\\,#2}",&#10; "\\gr": "\\gamma",&#10; "\\vec": "\\mathbf{#1}",&#10; "\\tagl": "\\tag{#1}",&#10; "\\eqref": "(#1)",&#10; "\\laplacian": "\\mathbf{\\nabla ^2}",&#10; "\\label": "{}",&#10; "\\negadelta": "\\nabla",&#10; "\\eqref": "\\href{###1}{(\\text{#1})}",&#10; "\\ref": "\\href{###1}{\\text{#1}}",&#10; "\\label": "\\htmlId{#1}{}",&#10; }&#10; });&#10; };&#10;&lt;/script&gt;&lt;span&gt;&#10; \[\]&#10;&lt;/span&gt;&#10;&#10;&lt;h1 id="particle-diagnostics-neutron-diagnostics-aria-johansen"&gt;Particle Diagnostics: Neutron diagnostics (Aria Johansen)&lt;a class="anchor" href="#particle-diagnostics-neutron-diagnostics-aria-johansen"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;p&gt;Start from the basics: what is a neutron? It&amp;rsquo;s a spin \( 1/2 \) baryon which interacts with all forces. Primarily decays into usually an electron and an antielectron neutron as well as a proton. Another decay process with 1/1000 of intensity decays to gamma. Mass is \( 939.6 MeV/c^2 \), very comparable to proton.&lt;/p&gt;</description></item><item><title>My class lecture</title><link>https://peppyhare.github.io/r/notes/UWAA560/91-zeeman-spectroscopy/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://peppyhare.github.io/r/notes/UWAA560/91-zeeman-spectroscopy/</guid><description>&lt;link rel="stylesheet" href="https://peppyhare.github.io/r/katex/katex.min.css" /&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/katex.min.js"&gt;&lt;/script&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/auto-render.min.js" onload="loadKatex();"&gt;&lt;/script&gt;&#10;&#10;&lt;script&gt;&#10; function loadKatex() {&#10; renderMathInElement(document.body, {&#10; delimiters: [&#10; { left: "$$", right: "$$", display: true },&#10; { left: "\\[", right: "\\]", display: true },&#10; { left: "$", right: "$", display: false },&#10; { left: "\\(", right: "\\)", display: false }],&#10; throwOnError: false,&#10; trust: (context) =&gt; ['\\htmlId', '\\href'].includes(context.command),&#10; macros: {&#10; "\\lcm": "\\mathop{\\mathrm{lcm}}",&#10; "\\sen": '\\text{sen}\\,',&#10; "\\dd": "\\mathop{\\mathrm{d} #1}",&#10; "\\abs": "\\lvert #1 \\rvert",&#10; "\\dd": "\\text{d}",&#10; "\\cross": "\\times",&#10; "\\pdv": "\\frac{\\partial #1}{\\partial #2}",&#10; "\\curl": "\\nabla \\cross #1",&#10; "\\vu": "\\mathbf{\\hat{#1}}",&#10; "\\vdot": "\\dot",&#10; "\\div": "\\nabla \\cdot #1",&#10; "\\grad": "\\nabla",&#10; "\\dv": "\\frac{d\\,#1}{d\\,#2}",&#10; "\\gr": "\\gamma",&#10; "\\vec": "\\mathbf{#1}",&#10; "\\tagl": "\\tag{#1}",&#10; "\\eqref": "(#1)",&#10; "\\laplacian": "\\mathbf{\\nabla ^2}",&#10; "\\label": "{}",&#10; "\\negadelta": "\\nabla",&#10; "\\eqref": "\\href{###1}{(\\text{#1})}",&#10; "\\ref": "\\href{###1}{\\text{#1}}",&#10; "\\label": "\\htmlId{#1}{}",&#10; }&#10; });&#10; };&#10;&lt;/script&gt;&lt;span&gt;&#10; \[\]&#10;&lt;/span&gt;&#10;&#10;&lt;h1 id="zeeman-spectroscopy"&gt;Zeeman Spectroscopy&lt;a class="anchor" href="#zeeman-spectroscopy"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;h2 id="motivation"&gt;Motivation&lt;a class="anchor" href="#motivation"&gt;#&lt;/a&gt;&lt;/h2&gt;&#10;&lt;p&gt;In high-energy-density plasmas, the current density distribution is strongly tied to the magnetic field distribution, and in some regions measurement of the B-field is the only way to obtain current density measurements. The magnetic field also determines resistivity, plasma dynamics, and energy balance.&lt;/p&gt;</description></item></channel></rss>