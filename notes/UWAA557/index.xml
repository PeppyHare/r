\\,#1}{d\\,#2}",&#10; "\\gr": "\\gamma",&#10; "\\vec": "\\mathbf{#1}",&#10; "\\tagl": "\\tag{#1}",&#10; "\\eqref": "(#1)",&#10; "\\laplacian": "\\mathbf{\\nabla ^2}",&#10; "\\label": "{}",&#10; "\\negadelta": "\\nabla",&#10; "\\eqref": "\\href{###1}{(\\text{#1})}",&#10; "\\ref": "\\href{###1}{\\text{#1}}",&#10; "\\label": "\\htmlId{#1}{}",&#10; }&#10; });&#10; };&#10;&lt;/script&gt;&lt;span&gt;&#10; \[\]&#10;&lt;/span&gt;&#10;&#10;&lt;p&gt;Jarboe&amp;rsquo;s &amp;lsquo;Rules of Thumb&amp;rsquo; - basic associations and concepts to keep in mind when working with fusion plasmas&lt;/p&gt;</description></item><item><title>Statistical Mechanics</title><link>https://peppyhare.github.io/r/notes/UWAA557/ch10-1/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://peppyhare.github.io/r/notes/UWAA557/ch10-1/</guid><description>&lt;h1 id="10-1-statistical-mechanics"&gt;&lt;strong&gt;10-1&lt;/strong&gt; Statistical Mechanics&lt;a class="anchor" href="#10-1-statistical-mechanics"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;!-- TA office: AERB 430 --&gt;&#10;&lt;h2 id="1011-very-large-numbers"&gt;&lt;strong&gt;10.1.1&lt;/strong&gt; Very Large Numbers&lt;a class="anchor" href="#1011-very-large-numbers"&gt;#&lt;/a&gt;&lt;/h2&gt;&#10;&lt;p&gt;Before getting started with real plasma physics concepts, we need to quickly review some statistical mechanics with the goal of deriving the Maxwell-Boltzmann distribution.&lt;/p&gt;&#10;&lt;p&gt;As we all know, if we have \( N \) unique objects, there are \( N! \) ways of arranging them. If \( n_1 \ldots n_k \) are identical with N things, the number of combinations is&lt;/p&gt;</description></item><item><title>Review of E&amp;M</title><link>https://peppyhare.github.io/r/notes/UWAA557/ch10-2/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://peppyhare.github.io/r/notes/UWAA557/ch10-2/</guid><description>&lt;h1 id="102-review-of-em"&gt;&lt;strong&gt;10.2&lt;/strong&gt; Review of E&amp;amp;M&lt;a class="anchor" href="#102-review-of-em"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;p&gt;Homework group: just me n &lt;a href="mailto:leek42@uw.edu"&gt;leek42@uw.edu&lt;/a&gt;&lt;/p&gt;&#10;&lt;p&gt;Realistically, all of the E&amp;amp;M review comes from &lt;a href="https://peppyhare.github.io/griffiths-em/"&gt;https://peppyhare.github.io/griffiths-em/&lt;/a&gt;&lt;/p&gt;&#10;&lt;h2 id="1011-maxwell-stress-tensor"&gt;&lt;strong&gt;10.1.1&lt;/strong&gt; Maxwell Stress Tensor&lt;a class="anchor" href="#1011-maxwell-stress-tensor"&gt;#&lt;/a&gt;&lt;/h2&gt;&#10;&lt;p&gt;The Maxwell stress tensor encompasses the way that electromagnetic fields an exert forces/stresses in 3D space:&lt;/p&gt;&#10;&#10;&lt;link rel="stylesheet" href="https://peppyhare.github.io/r/katex/katex.min.css" /&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/katex.min.js"&gt;&lt;/script&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/auto-render.min.js" onload="loadKatex();"&gt;&lt;/script&gt;&#10;&#10;&lt;script&gt;&#10; function loadKatex() {&#10; renderMathInElement(document.body, {&#10; delimiters: [&#10; { left: "$$", right: "$$", display: true },&#10; { left: "\\[", right: "\\]", display: true },&#10; { left: "$", right: "$", display: false },&#10; { left: "\\(", right: "\\)", display: false }],&#10; throwOnError: false,&#10; trust: (context) =&gt; ['\\htmlId', '\\href'].includes(context.command),&#10; macros: {&#10; "\\lcm": "\\mathop{\\mathrm{lcm}}",&#10; "\\sen": '\\text{sen}\\,',&#10; "\\dd": "\\mathop{\\mathrm{d} #1}",&#10; "\\abs": "\\lvert #1 \\rvert",&#10; "\\dd": "\\text{d}",&#10; "\\cross": "\\times",&#10; "\\pdv": "\\frac{\\partial #1}{\\partial #2}",&#10; "\\curl": "\\nabla \\cross #1",&#10; "\\vu": "\\mathbf{\\hat{#1}}",&#10; "\\vdot": "\\dot",&#10; "\\div": "\\nabla \\cdot #1",&#10; "\\grad": "\\nabla",&#10; "\\dv": "\\frac{d\\,#1}{d\\,#2}",&#10; "\\gr": "\\gamma",&#10; "\\vec": "\\mathbf{#1}",&#10; "\\tagl": "\\tag{#1}",&#10; "\\eqref": "(#1)",&#10; "\\laplacian": "\\mathbf{\\nabla ^2}",&#10; "\\label": "{}",&#10; "\\negadelta": "\\nabla",&#10; "\\eqref": "\\href{###1}{(\\text{#1})}",&#10; "\\ref": "\\href{###1}{\\text{#1}}",&#10; "\\label": "\\htmlId{#1}{}",&#10; }&#10; });&#10; };&#10;&lt;/script&gt;&lt;span&gt;&#10; \[\vec p = \text{ momentum }\]&#10;&lt;/span&gt;&#10;&#10;&lt;p&gt;The basic force laws of E&amp;amp;M are&lt;/p&gt;</description></item><item><title>Lagrange Multipliers</title><link>https://peppyhare.github.io/r/notes/UWAA557/ch10-3/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://peppyhare.github.io/r/notes/UWAA557/ch10-3/</guid><description>&lt;h2 id="lagrange-multipliers"&gt;Lagrange Multipliers&lt;a class="anchor" href="#lagrange-multipliers"&gt;#&lt;/a&gt;&lt;/h2&gt;&#10;&lt;p&gt;When we have a problem of variation where one function is maximized or minimized subject to a constraint imposed by another function&lt;/p&gt;&#10;&#10;&lt;link rel="stylesheet" href="https://peppyhare.github.io/r/katex/katex.min.css" /&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/katex.min.js"&gt;&lt;/script&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/auto-render.min.js" onload="loadKatex();"&gt;&lt;/script&gt;&#10;&#10;&lt;script&gt;&#10; function loadKatex() {&#10; renderMathInElement(document.body, {&#10; delimiters: [&#10; { left: "$$", right: "$$", display: true },&#10; { left: "\\[", right: "\\]", display: true },&#10; { left: "$", right: "$", display: false },&#10; { left: "\\(", right: "\\)", display: false }],&#10; throwOnError: false,&#10; trust: (context) =&gt; ['\\htmlId', '\\href'].includes(context.command),&#10; macros: {&#10; "\\lcm": "\\mathop{\\mathrm{lcm}}",&#10; "\\sen": '\\text{sen}\\,',&#10; "\\dd": "\\mathop{\\mathrm{d} #1}",&#10; "\\abs": "\\lvert #1 \\rvert",&#10; "\\dd": "\\text{d}",&#10; "\\cross": "\\times",&#10; "\\pdv": "\\frac{\\partial #1}{\\partial #2}",&#10; "\\curl": "\\nabla \\cross #1",&#10; "\\vu": "\\mathbf{\\hat{#1}}",&#10; "\\vdot": "\\dot",&#10; "\\div": "\\nabla \\cdot #1",&#10; "\\grad": "\\nabla",&#10; "\\dv": "\\frac{d\\,#1}{d\\,#2}",&#10; "\\gr": "\\gamma",&#10; "\\vec": "\\mathbf{#1}",&#10; "\\tagl": "\\tag{#1}",&#10; "\\eqref": "(#1)",&#10; "\\laplacian": "\\mathbf{\\nabla ^2}",&#10; "\\label": "{}",&#10; "\\negadelta": "\\nabla",&#10; "\\eqref": "\\href{###1}{(\\text{#1})}",&#10; "\\ref": "\\href{###1}{\\text{#1}}",&#10; "\\label": "\\htmlId{#1}{}",&#10; }&#10; });&#10; };&#10;&lt;/script&gt;&lt;span&gt;&#10; \[f(x_1, \ldots x_n) \rightarrow \text{ function }\]&#10;&lt;/span&gt;&#10;&#10;&lt;span&gt;&#10; \[g(x_1, \ldots, x_n) = 0 \rightarrow \text { constraint }\]&#10;&lt;/span&gt;&#10;&#10;&lt;p&gt;Without the constraint we would have the problem&lt;/p&gt;</description></item><item><title>Wall-supported Plasma</title><link>https://peppyhare.github.io/r/notes/UWAA557/ch11-1/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://peppyhare.github.io/r/notes/UWAA557/ch11-1/</guid><description>&lt;h1 id="wall-supported-plasma"&gt;Wall-supported Plasma&lt;a class="anchor" href="#wall-supported-plasma"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;p&gt;Consider a &amp;ldquo;hot&amp;rdquo; plasma surrounded by a &amp;ldquo;cold&amp;rdquo; wall. What are the properties of the plasma (both electrons and ions) at the wall? The speed of a particle headed towards the wall is&lt;/p&gt;&#10;&#10;&lt;link rel="stylesheet" href="https://peppyhare.github.io/r/katex/katex.min.css" /&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/katex.min.js"&gt;&lt;/script&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/auto-render.min.js" onload="loadKatex();"&gt;&lt;/script&gt;&#10;&#10;&lt;script&gt;&#10; function loadKatex() {&#10; renderMathInElement(document.body, {&#10; delimiters: [&#10; { left: "$$", right: "$$", display: true },&#10; { left: "\\[", right: "\\]", display: true },&#10; { left: "$", right: "$", display: false },&#10; { left: "\\(", right: "\\)", display: false }],&#10; throwOnError: false,&#10; trust: (context) =&gt; ['\\htmlId', '\\href'].includes(context.command),&#10; macros: {&#10; "\\lcm": "\\mathop{\\mathrm{lcm}}",&#10; "\\sen": '\\text{sen}\\,',&#10; "\\dd": "\\mathop{\\mathrm{d} #1}",&#10; "\\abs": "\\lvert #1 \\rvert",&#10; "\\dd": "\\text{d}",&#10; "\\cross": "\\times",&#10; "\\pdv": "\\frac{\\partial #1}{\\partial #2}",&#10; "\\curl": "\\nabla \\cross #1",&#10; "\\vu": "\\mathbf{\\hat{#1}}",&#10; "\\vdot": "\\dot",&#10; "\\div": "\\nabla \\cdot #1",&#10; "\\grad": "\\nabla",&#10; "\\dv": "\\frac{d\\,#1}{d\\,#2}",&#10; "\\gr": "\\gamma",&#10; "\\vec": "\\mathbf{#1}",&#10; "\\tagl": "\\tag{#1}",&#10; "\\eqref": "(#1)",&#10; "\\laplacian": "\\mathbf{\\nabla ^2}",&#10; "\\label": "{}",&#10; "\\negadelta": "\\nabla",&#10; "\\eqref": "\\href{###1}{(\\text{#1})}",&#10; "\\ref": "\\href{###1}{\\text{#1}}",&#10; "\\label": "\\htmlId{#1}{}",&#10; }&#10; });&#10; };&#10;&lt;/script&gt;&lt;span&gt;&#10; \[\frac{1}{2} m v_{th} ^2 \approx \frac{1}{2} kT \rightarrow v_{th} \approx \sqrt{ \frac{kT}{m}}\]&#10;&lt;/span&gt;&#10;&#10;&lt;p&gt;Since electrons are much lighter than ions (\( m_e = m_i / 1800 \) for hydrogen), they are moving much faster and will leave the plasma at a much higher rate than the ions. The outflow of negative charge causes a positive buildup in the plasma, slowing the electron loss until the electrons and ions leave at the same rate&lt;/p&gt;</description></item><item><title>Collisions</title><link>https://peppyhare.github.io/r/notes/UWAA557/ch11-2/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://peppyhare.github.io/r/notes/UWAA557/ch11-2/</guid><description>&lt;h1 id="collisions"&gt;Collisions&lt;a class="anchor" href="#collisions"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;p&gt;If \( \Lambda \) is large, then small-angle scattering dominates.&lt;/p&gt;&#10;&#10;&lt;link rel="stylesheet" href="https://peppyhare.github.io/r/katex/katex.min.css" /&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/katex.min.js"&gt;&lt;/script&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/auto-render.min.js" onload="loadKatex();"&gt;&lt;/script&gt;&#10;&#10;&lt;script&gt;&#10; function loadKatex() {&#10; renderMathInElement(document.body, {&#10; delimiters: [&#10; { left: "$$", right: "$$", display: true },&#10; { left: "\\[", right: "\\]", display: true },&#10; { left: "$", right: "$", display: false },&#10; { left: "\\(", right: "\\)", display: false }],&#10; throwOnError: false,&#10; trust: (context) =&gt; ['\\htmlId', '\\href'].includes(context.command),&#10; macros: {&#10; "\\lcm": "\\mathop{\\mathrm{lcm}}",&#10; "\\sen": '\\text{sen}\\,',&#10; "\\dd": "\\mathop{\\mathrm{d} #1}",&#10; "\\abs": "\\lvert #1 \\rvert",&#10; "\\dd": "\\text{d}",&#10; "\\cross": "\\times",&#10; "\\pdv": "\\frac{\\partial #1}{\\partial #2}",&#10; "\\curl": "\\nabla \\cross #1",&#10; "\\vu": "\\mathbf{\\hat{#1}}",&#10; "\\vdot": "\\dot",&#10; "\\div": "\\nabla \\cdot #1",&#10; "\\grad": "\\nabla",&#10; "\\dv": "\\frac{d\\,#1}{d\\,#2}",&#10; "\\gr": "\\gamma",&#10; "\\vec": "\\mathbf{#1}",&#10; "\\tagl": "\\tag{#1}",&#10; "\\eqref": "(#1)",&#10; "\\laplacian": "\\mathbf{\\nabla ^2}",&#10; "\\label": "{}",&#10; "\\negadelta": "\\nabla",&#10; "\\eqref": "\\href{###1}{(\\text{#1})}",&#10; "\\ref": "\\href{###1}{\\text{#1}}",&#10; "\\label": "\\htmlId{#1}{}",&#10; }&#10; });&#10; };&#10;&lt;/script&gt;&lt;span&gt;&#10; \[\nu = \frac{n}{2 \pi \epsilon_0 ^2} \frac{ e^4}{m^2 v_0 ^3} \ln \Alpha \propto \frac{n}{T^{3/2} m^{1/2}}\]&#10;&lt;/span&gt;&#10;&#10;&lt;h2 id="paschen-curve-for-breakdown"&gt;Paschen curve for breakdown&lt;a class="anchor" href="#paschen-curve-for-breakdown"&gt;#&lt;/a&gt;&lt;/h2&gt;&#10;&lt;p&gt;Say we have two large parallel plates&lt;/p&gt;</description></item><item><title>Oscillations</title><link>https://peppyhare.github.io/r/notes/UWAA557/ch11-3/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://peppyhare.github.io/r/notes/UWAA557/ch11-3/</guid><description>&lt;h1 id="oscillations"&gt;Oscillations&lt;a class="anchor" href="#oscillations"&gt;#&lt;/a&gt;&lt;/h1&gt;&#10;&lt;h2 id="collision-frequencies"&gt;Collision Frequencies&lt;a class="anchor" href="#collision-frequencies"&gt;#&lt;/a&gt;&lt;/h2&gt;&#10;&lt;p&gt;Gases have three degrees of freedom to oscillate, but plasmas have four: the electron fluid adds an additional parameter.&lt;/p&gt;&#10;&lt;p&gt;One way to see how the electron fluid oscillates, take a region of plasma and displace the electrons by a distance \( x \) and release. Then, watch how the electrons oscillate.&lt;/p&gt;&#10;&lt;p align="center"&gt; &lt;img alt="Figure 11.1" src="https://peppyhare.github.io/r/img/11.1.png" /&gt; &lt;/p&gt;&#10;&lt;p&gt;Gauss&amp;rsquo;s law gives the resulting electric field (same as a parallel-plate capacitor.&lt;/p&gt;&#10;&#10;&lt;link rel="stylesheet" href="https://peppyhare.github.io/r/katex/katex.min.css" /&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/katex.min.js"&gt;&lt;/script&gt;&#10;&lt;script defer src="https://peppyhare.github.io/r/katex/auto-render.min.js" onload="loadKatex();"&gt;&lt;/script&gt;&#10;&#10;&lt;script&gt;&#10; function loadKatex() {&#10; renderMathInElement(document.body, {&#10; delimiters: [&#10; { left: "$$", right: "$$", display: true },&#10; { left: "\\[", right: "\\]", display: true },&#10; { left: "$", right: "$", display: false },&#10; { left: "\\(", right: "\\)", display: false }],&#10; throwOnError: false,&#10; trust: (context) =&gt; ['\\htmlId', '\\href'].includes(context.command),&#10; macros: {&#10; "\\lcm": "\\mathop{\\mathrm{lcm}}",&#10; "\\sen": '\\text{sen}\\,',&#10; "\\dd": "\\mathop{\\mathrm{d} #1}",&#10; "\\abs": "\\lvert #1 \\rvert",&#10; "\\dd": "\\text{d}",&#10; "\\cross": "\\times",&#10; "\\pdv": "\\frac{\\partial #1}{\\partial #2}",&#10; "\\curl": "\\nabla \\cross #1",&#10; "\\vu": "\\mathbf{\\hat{#1}}",&#10; "\\vdot": "\\dot",&#10; "\\div": "\\nabla \\cdot #1",&#10; "\\grad": "\\nabla",&#10; "\\dv": "\\frac{d\\,#1}{d\\,#2}",&#10; "\\gr": "\\gamma",&#10; "\\vec": "\\mathbf{#1}",&#10; "\\tagl": "\\tag{#1}",&#10; "\\eqref": "(#1)",&#10; "\\laplacian": "\\mathbf{\\nabla ^2}",&#10; "\\label": "{}",&#10; "\\negadelta": "\\nabla",&#10; "\\eqref": "\\href{###1}{(\\text{#1})}",&#10; "\\ref": "\\href{###1}{\\text{#1}}",&#10; "\\label": "\\htmlId{#1}{}",&#10; }&#10; });&#10; };&#10;&lt;/script&gt;&lt;span&gt;&#10; \[E = \frac{n e x}{\epsilon_0}\]&#10;&lt;/span&gt;&#10;&#10;&lt;p&gt;The restoring force is therefore&lt;/p&gt;</description></item></channel></rss>